<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_rating"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:visibility="visible"
        app:cardBackgroundColor="#ffffffff"
        app:cardCornerRadius="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/ll_job_driver_details"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="5.0dip"
                android:visibility="visible">

                <com.instaguard.user.CustomViews.CustomTextView
                    android:id="@+id/iv_count"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                    android:background="@drawable/ic_circle_elevation_white"
                    android:contentDescription="@string/todo"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/iv_user_prof_pic_job_inprogress"
                    android:layout_width="45.0dip"
                    android:layout_height="45.0dip"
                    android:layout_alignParentStart="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dip"
                    android:layout_marginTop="10dip"
                    android:layout_marginEnd="5dip"
                    android:layout_toEndOf="@+id/iv_count"
                    android:background="@drawable/logo_circle"
                    android:scaleType="fitXY"
                    app:placeholderImage="@mipmap/male"
                    app:placeholderImageScaleType="fitXY"
                    app:roundedCornerRadius="0dp" />

                <LinearLayout
                    android:id="@+id/txt_Driver_info_label"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dip"
                    android:layout_marginEnd="0dip"
                    android:layout_marginBottom="10dip"
                    android:layout_toStartOf="@+id/ll_call_msg_lyt"
                    android:layout_toEndOf="@+id/iv_user_prof_pic_job_inprogress"
                    android:orientation="vertical">

                    <com.instaguard.user.CustomViews.CustomTextView
                        android:id="@+id/txt_username_job_inprogress"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:layout_marginStart="5.0dip"
                        android:gravity="start|center"
                        android:maxLines="2"
                        android:text="@string/app_name"
                        android:textAlignment="viewStart"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.instaguard.user.Helpers.RatingBar.SimpleRatingBar
                        android:id="@+id/ratingbar_job_inprogress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:clickable="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:padding="2.0dip"
                        android:visibility="invisible"
                        app:srb_borderColor="@color/colorPrimary"
                        app:srb_fillColor="@color/colorPrimaryDark"
                        app:srb_numberOfStars="5"
                        app:srb_rating="3"
                        app:srb_starBorderWidth="2"
                        app:srb_starSize="14sp"
                        app:srb_stepSize="0.5" />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_call_msg_lyt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerInParent="true"
                    android:gravity="center|end"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_phone"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="center|start"
                        android:layout_margin="3dp"
                        android:background="@drawable/ic_circle_elevation_white"
                        android:contentDescription="@string/todo"
                        android:padding="11dp"
                        android:src="@drawable/ic_baseline_phone_24"
                        android:visibility="gone"
                        app:tint="@color/colorPrimaryDark" />


                    <ImageView
                        android:id="@+id/headerIndicator"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/ic_circle_elevation_white"
                        android:contentDescription="@string/todo"
                        android:padding="8dp"
                        android:src="@drawable/ic_expansion_header_indicator_grey_24dp"
                        android:visibility="invisible" />

                </LinearLayout>

            </RelativeLayout>

            <com.instaguard.user.CustomViews.CustomTextView
                android:id="@+id/ufxratingDriverHTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="15dp"
                android:gravity="center|start"
                android:text="@string/review_successfully_updated"
                android:textColor="@color/colorPrimary_light"
                android:textSize="16sp"
                android:visibility="visible" />

            <RelativeLayout
                android:id="@+id/rl_parent_rating_edt_rate_lyt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible">

                <com.instaguard.user.Helpers.RatingBar.SimpleRatingBar
                    android:id="@+id/ratingbar_trip_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="5dp"
                    android:padding="2.0dip"
                    app:srb_borderColor="@color/colorPrimary"
                    app:srb_fillColor="@color/colorPrimaryDark"
                    app:srb_numberOfStars="5"
                    app:srb_starBorderWidth="2"
                    app:srb_starSize="28sp"
                    app:srb_stepSize="0.5" />

                <com.instaguard.user.CustomViews.CustomEditText
                    android:id="@+id/edt_comment_trip_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/ratingbar_trip_summary"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="5dp"
                    android:layout_toStartOf="@+id/btn_rating_payment"
                    android:clickable="false"
                    android:digits="._abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890@ "
                    android:hint="@string/trip_summary_enter_your_comment"
                    android:inputType="textEmailAddress"
                    android:maxLines="3"
                    android:paddingEnd="10dp"
                    android:textAlignment="viewStart"
                    app:met_floatingLabel="highlight"
                    app:met_floatingLabelAlwaysShown="false"
                    app:met_floatingLabelAnimating="true"
                    app:met_floatingLabelTextColor="@color/black"
                    app:met_textColorHint="@color/hintgray"
                    app:met_underlineColor="@color/hintgray"
                    tools:ignore="RtlSymmetry" />

                <com.instaguard.user.CustomViews.CustomButton
                    android:id="@+id/btn_rating_payment"
                    android:layout_width="wrap_content"
                    android:layout_height="35sp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_rect_filled_colorprimary"
                    android:gravity="center"
                    android:text="@string/trip_summary_rate"
                    android:textColor="@color/white" />

            </RelativeLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>