<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="#fff5f5f5"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10.0dip"
        android:layout_marginTop="10.0dip"
        android:layout_marginEnd="10.0dip"
        android:layout_marginBottom="5.0dip"
        android:orientation="horizontal"
        android:visibility="gone">


        <com.instaguard.user.CustomViews.CustomTextView
            android:id="@+id/txt_bookingdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center"
            android:layout_marginStart="5.0dip"
            android:layout_marginTop="4.0dip"
            android:gravity="start|center"
            android:maxLines="1"
            android:text="17th sep at 9:00 PM"
            android:textColor="#ffc1c1c1"
            android:textSize="14sp"
            android:textStyle="normal"
            android:visibility="gone" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5.0dip"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="5.0dip"
        android:layout_marginBottom="5.0dip"
        android:background="#fff5f5f5"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="5.0dip"
        app:cardElevation="3.0dip"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:id="@+id/contentArea"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_deliverdetails"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:background="#ffffffff"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@color/colorPrimary_light"
                    android:gravity="center|start"
                    android:orientation="horizontal"
                    android:padding="8dip">

                    <com.instaguard.user.CustomViews.CustomTextView
                        android:id="@+id/txt_bookingno_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:gravity="start|center"
                        android:maxLines="1"
                        android:text="@string/ongoingjobs_booking_no_label"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="normal" />

                    <com.instaguard.user.CustomViews.CustomTextView
                        android:id="@+id/txt_bookingid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:layout_marginStart="3.0dip"
                        android:gravity="start|center"
                        android:maxLines="1"
                        android:text="#"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:orientation="horizontal">

                    <com.instaguard.user.CustomViews.CustomTextView
                        android:id="@+id/txt_booking_date"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:layout_margin="5.0dip"
                        android:drawableStart="@drawable/ic_greendot"
                        android:drawablePadding="5dp"
                        android:drawableTint="@color/colorAccent"
                        android:gravity="center|start"
                        android:maxLines="1"
                        android:padding="5dp"
                        android:text="@string/pickup_date"
                        android:textColor="#ff0f0f0f"
                        android:textSize="14sp"
                        android:textStyle="normal" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4.0dip"
                    android:layout_weight="1.0"
                    android:orientation="horizontal">

                    <com.instaguard.user.CustomViews.CustomTextView
                        android:id="@+id/txt_booking_category"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:layout_margin="5.0dip"
                        android:drawableStart="@drawable/ic_greendot"
                        android:drawablePadding="5dp"
                        android:drawableTint="@color/colorAccent"
                        android:gravity="center|start"
                        android:maxLines="1"
                        android:padding="5dp"
                        android:text="@string/category_name"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="14sp"
                        android:textStyle="normal" />

                </LinearLayout>

                <com.instaguard.user.CustomViews.CustomTextView
                    android:id="@+id/txt_provideraddress"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center"
                    android:layout_margin="5.0dip"
                    android:drawableStart="@drawable/ic_greendot"
                    android:drawablePadding="5dp"
                    android:gravity="center|start"
                    android:padding="5dp"
                    android:text="@string/pickup_address"
                    android:textColor="#ff1e1e1e"
                    android:textSize="14sp"
                    android:textStyle="normal" />

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10.0dip"
                    android:layout_marginTop="5.0dip"
                    android:layout_marginEnd="10.0dip"
                    android:layout_marginBottom="5.0dip"
                    android:gravity="start|center|top"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="90.0dip"
                        android:layout_height="90.0dip"
                        android:background="@color/colorPrimary"
                        android:padding="1.0dip"
                        android:visibility="gone" />

                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/img_booking_driver"
                        android:layout_width="80.0dip"
                        android:layout_height="80.0dip"
                        android:scaleType="centerCrop"
                        app:actualImageScaleType="fitXY"
                        app:placeholderImage="@mipmap/male"
                        app:placeholderImageScaleType="fitXY" />

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10.0dip"
                        android:orientation="vertical">

                        <com.instaguard.user.CustomViews.CustomTextView
                            android:id="@+id/txt_providername"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center|top"
                            android:layout_marginStart="5.0dip"
                            android:gravity="start|center"
                            android:maxLines="1"
                            android:text="@string/app_name"
                            android:textAlignment="viewStart"
                            android:textColor="@color/colorPrimary"
                            android:textSize="18dp"
                            android:textStyle="bold" />

                        <com.instaguard.user.CustomViews.CustomTextView
                            android:id="@+id/txt_Driver_company"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/txt_Driver_ph_label"
                            android:layout_gravity="start|center|top"
                            android:layout_marginStart="5.0dip"
                            android:layout_marginTop="5.0dip"
                            android:layout_toStartOf="@+id/ll_call_msg_lyt"
                            android:gravity="start|center"
                            android:hint=""
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textColor="@color/grey_80"
                            android:textSize="13sp"
                            android:visibility="gone" />


                        <com.instaguard.user.Helpers.RatingBar.SimpleRatingBar
                            android:id="@+id/rb_provider"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:padding="2.0dip"
                            app:srb_borderColor="@color/colorPrimary"
                            app:srb_fillColor="@color/colorPrimaryDark"
                            app:srb_numberOfStars="5"
                            app:srb_rating="3"
                            app:srb_starBorderWidth="2"
                            app:srb_starSize="14sp"
                            app:srb_stepSize="0.5" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dip"
                    android:background="#ffcecece"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ll_btnarea"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/liveTrackBtnArea"
                        android:layout_width="0.0dip"
                        android:layout_height="fill_parent"
                        android:layout_gravity="center"
                        android:layout_margin="5.0dip"
                        android:layout_weight="1.0"
                        android:background="@color/colorPrimary"
                        android:gravity="center"
                        android:visibility="gone">

                        <com.instaguard.user.CustomViews.CustomTextView
                            android:id="@+id/liveTrackBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center"
                            android:layout_marginStart="5.0dip"
                            android:text="@string/live_track"
                            android:textAlignment="center"
                            android:textAllCaps="true"
                            android:textColor="@color/colorPrimary"
                            android:textSize="14dp"
                            android:textStyle="normal" />
                    </LinearLayout>

                    <View
                        android:layout_width="0.5dip"
                        android:layout_height="fill_parent"
                        android:background="#ffcecece"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/ll_viewdetails"
                        android:layout_width="0.0dip"
                        android:layout_height="45.0dip"
                        android:layout_gravity="center"
                        android:layout_marginTop="5.0dip"
                        android:orientation="vertical"
                        android:layout_weight="1.0"
                        android:background="@color/colorPrimaryDark"
                        android:gravity="center">

                        <com.instaguard.user.CustomViews.CustomButton
                            android:id="@+id/btn_viewdetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center"
                            android:background="@android:color/transparent"
                            android:drawableEnd="@drawable/ic_baseline_chevron_right_24"
                            android:drawablePadding="5dp"
                            android:drawableTint="@color/white"
                            android:padding="5dp"
                            android:text="@string/ongoingjobs_view_details"
                            android:textAllCaps="true"
                            android:visibility="gone"
                            android:textColor="@color/white"
                            android:textStyle="normal" />

                        <com.instaguard.user.CustomViews.CustomButton
                            android:id="@+id/btn_cancel_request"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center"
                            android:background="@color/colorPrimary"
                            android:drawablePadding="5dp"
                            android:drawableTint="@color/white"
                            android:padding="5dp"
                            android:text="@string/cancel_booking"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textStyle="normal" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <com.instaguard.user.CustomViews.CustomTextView
        android:id="@+id/txt_booklater_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_gravity="start|center"
        android:layout_marginTop="2.5dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/bg_rect_filled_booknowlater_select_cp"
        android:backgroundTint="@color/colorPrimary"
        android:elevation="10dp"
        android:gravity="start|center"
        android:maxLines="1"
        android:paddingStart="7.5dp"
        android:paddingTop="5dp"
        android:paddingEnd="7.5dp"
        android:paddingBottom="5dp"
        android:text="@string/upcomingjobs"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</RelativeLayout>