<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toBottomOf="parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragments.GuardUniqueIdFragment">

    <View
        android:id="@+id/view"
        android:layout_width="80sp"
        android:layout_height="3sp"
        android:layout_marginTop="@dimen/marginBottom_10"
        app:layout_constraintVertical_chainStyle="packed"
        android:background="@color/lightGrey"
        app:layout_constraintBottom_toTopOf="@+id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_guard_with_unique_id"
        android:textSize="18sp"
        android:textColor="@color/black"
        app:layout_constraintBottom_toTopOf="@+id/view2"
        app:layout_constraintTop_toBottomOf="@+id/view"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textStyle="bold"/>

    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14sp"
        android:background="@color/lightGrey"
        android:layout_marginStart="20sp"
        android:layout_marginEnd="20sp"
        app:layout_constraintBottom_toTopOf="@+id/rvGuard"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGuard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view2"
        android:layout_marginTop="@dimen/marginTop_20"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="horizontal"
        tools:listitem="@layout/layout_guard_chip"/>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/uniqueId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/marginTop_20"
        android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890"
        android:maxLines="1"
        android:inputType="textCapCharacters"
        android:layout_marginBottom="@dimen/marginTop_20"
        app:layout_constraintBottom_toTopOf="@+id/submit"
        app:layout_constraintTop_toBottomOf="@+id/rvGuard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/validateUniqueIdBtn"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/validateUniqueIdBtn"
        android:layout_width="140dp"
        android:layout_height="38sp"
        android:layout_marginEnd="@dimen/marginTop_20"
        android:text="@string/validate"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:background="@color/colorAccent"
        app:layout_constraintTop_toTopOf="@+id/uniqueId"
        app:layout_constraintBottom_toBottomOf="@+id/uniqueId"
        app:layout_constraintStart_toEndOf="@+id/uniqueId"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/submit"
        android:layout_width="0dp"
        android:layout_height="40sp"
        app:layout_constraintStart_toStartOf="@+id/uniqueId"
        app:layout_constraintEnd_toEndOf="@+id/validateUniqueIdBtn"
        android:background="@color/colorPrimary"
        android:textSize="@dimen/fab_margin_16"
        android:text="@string/forgetpassword_submit"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/marginTop_20"/>

    <include
        android:id="@+id/lyt_progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/layout_progress_bar"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>