<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="2"
    tools:context=".Activities.HomeMainActivity">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar_gradient"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_scrollFlags="scroll|enterAlways"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:theme="@style/Toolbar.Light">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/img_menu"
                style="@style/AppThemeToolBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:layout_marginTop="5dp"
                android:contentDescription="@string/todo"
                android:padding="10dp"
                android:src="@drawable/ic_menu_black" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/img_menu"
                android:layout_alignBottom="@+id/img_menu"
                android:layout_toStartOf="@+id/iv_alert_main"
                android:layout_toEndOf="@+id/img_menu"
                android:contentDescription="@string/todo"
                android:padding="5dp"
                android:src="@drawable/logo_circle" />

            <com.instaguard.user.CustomViews.CustomTextView
                android:id="@+id/toolbar_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/img_menu"
                android:layout_alignBottom="@+id/img_menu"
                android:layout_gravity="center"
                android:layout_toStartOf="@+id/iv_alert_main"
                android:layout_toEndOf="@+id/img_menu"
                android:gravity="center"
                android:text="@string/app_name_toolbar"
                android:textAllCaps="true"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_alert_main"
                style="@style/AppThemeToolBar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_margin="5dp"
                android:contentDescription="@string/todo"
                android:padding="10dp"
                android:src="@mipmap/ic_eme_alert"
                app:tint="@android:color/holo_red_dark" />

        </RelativeLayout>

    </android.widget.Toolbar>

    <com.instaguard.user.CustomViews.CustomTextView
        android:id="@+id/txt_select_service_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:padding="5dp"
        android:text="@string/select_service"
        android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
        android:textColor="@color/colorPrimaryDark" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:id="@+id/ll_one"
        android:layout_marginStart="25dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="25dp"
        android:background="@drawable/bg_square_shape_corner_color"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="15dp"
            android:contentDescription="@string/todo"
            android:padding="10dp"
            android:layout_above="@+id/txt_one_"
            android:src="@drawable/ic_hatchback" />


        <com.instaguard.user.CustomViews.CustomTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="-5dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:padding="10dp"
            android:id="@+id/txt_one_"
            android:layout_alignParentBottom="true"
            android:text="Road Assistance"
            android:textColor="@color/black"
            android:textSize="18sp" />


    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:id="@+id/ll_two"
        android:layout_marginStart="25dp"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="25dp"
        android:background="@drawable/bg_square_shape_corner_color_gray"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="15dp"
            android:contentDescription="@string/todo"
            android:padding="10dp"
            android:layout_above="@+id/txt_two_"
            android:src="@drawable/ic_hatchback" />

        <com.instaguard.user.CustomViews.CustomTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="-5dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:padding="10dp"
            android:id="@+id/txt_two_"
            android:layout_alignParentBottom="true"
            android:text="Cargo and Bus Hailing"
            android:textColor="@color/black"
            android:textSize="18sp" />

    </RelativeLayout>

</LinearLayout>