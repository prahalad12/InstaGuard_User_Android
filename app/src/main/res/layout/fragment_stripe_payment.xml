<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <android.widget.Toolbar
        android:id="@+id/toolbar_stripe"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@drawable/bg_toolbar_gradient">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/imgbtn_back"
                style="@style/AppThemeToolBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:contentDescription="@string/todo"
                android:padding="10dp"
                android:src="@drawable/ic_back_whitearrow" />

            <com.instaguard.user.CustomViews.CustomTextView
                android:id="@+id/textView"
                style="@style/AppThemeToolBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/imgbtn_back"
                android:layout_alignBottom="@+id/imgbtn_back"
                android:layout_centerInParent="true"
                android:layout_marginStart="0dp"
                android:layout_toStartOf="@+id/iv_menu_profile"
                android:layout_toEndOf="@+id/imgbtn_back"
                android:foregroundGravity="center"
                android:gravity="center|start"
                android:text="@string/stripe_payment"
                android:textAlignment="viewStart"
                tools:ignore="MissingPrefix" />

            <ImageView
                android:id="@+id/iv_menu_profile"
                style="@style/AppThemeToolBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/imgbtn_back"
                android:layout_alignBottom="@+id/imgbtn_back"
                android:layout_alignParentEnd="true"
                android:layout_gravity="top|right"
                android:layout_marginEnd="15dp"
                android:contentDescription="@string/todo"
                android:padding="5dp"
                android:src="@drawable/ic_menu_vertical"
                android:visibility="invisible"
                tools:ignore="RtlHardcoded" />
        </RelativeLayout>
    </android.widget.Toolbar>


    <!-- <ScrollView
         android:id="@+id/scrollView"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:layout_below="@+id/toolbar_stripe"
         android:background="@color/bg_gray_common"
         android:scrollbars="none">-->

    <RelativeLayout
        android:id="@+id/rl_parent_lyt_stripe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar_stripe"
        android:background="@color/bg_gray_common">

        <LinearLayout
            android:id="@+id/ll_stripe_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <com.instaguard.user.Helpers.Creditcard.fields.CreditCardModule
                android:id="@+id/credit_card_module"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone" />

            <!--<com.stripe.android.view.CardInputWidget
                android:id="@+id/credit_card_module_stripe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="15dp" />-->

        </LinearLayout>

        <com.instaguard.user.CustomViews.CustomButton
            android:id="@+id/pay_button"
            android:layout_width="match_parent"
            android:layout_height="45sp"
            android:layout_alignParentBottom="true"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_rect_filled_colorprimary"
            android:gravity="center"
            android:text="@string/pay"
            android:textAllCaps="true"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </RelativeLayout>

    <com.instaguard.user.CustomViews.CustomTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="20sp"
        android:gravity="start"
        android:hint="for Demo use:- \n Creditcard: 4111 1111 1111 1111 \n mm/yy : 06/22 \n cvv :123"
        android:textColorHint="@android:color/darker_gray"
        android:visibility="gone" />

    <!--
        </ScrollView>
    -->
</RelativeLayout>
