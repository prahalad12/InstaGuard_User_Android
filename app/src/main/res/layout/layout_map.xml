<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.instaguard.user.Activities.MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/rl_bottom_parent"
            android:layout_alignParentTop="true" />

        <android.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_toolbar_gradient"
            app:contentInsetStartWithNavigation="0dp"
            app:layout_scrollFlags="scroll|enterAlways"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:theme="@style/Toolbar.Light">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/img_menu"
                    style="@style/AppThemeToolBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center"
                    android:layout_marginTop="5dp"
                    android:contentDescription="@string/todo"
                    android:padding="10dp"
                    android:src="@drawable/ic_back_whitearrow" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/img_menu"
                    android:layout_alignBottom="@+id/img_menu"
                    android:layout_toStartOf="@+id/iv_alert_main"
                    android:layout_toEndOf="@+id/img_menu"
                    android:contentDescription="@string/todo"
                    android:padding="5dp"
                    android:src="@drawable/logo" />

                <com.instaguard.user.CustomViews.CustomTextView
                    android:id="@+id/toolbar_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/img_menu"
                    android:layout_alignBottom="@+id/img_menu"
                    android:layout_gravity="center"
                    android:layout_toStartOf="@+id/iv_alert_main"
                    android:layout_toEndOf="@+id/img_menu"
                    android:gravity="center"
                    android:text="@string/app_name_toolbar"
                    android:textAllCaps="true"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_alert_main"
                    style="@style/AppThemeToolBar"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="5dp"
                    android:contentDescription="@string/todo"
                    android:visibility="invisible"
                    android:padding="10dp"
                    android:src="@mipmap/ic_eme_alert"
                    app:tint="@android:color/holo_red_dark" />

            </RelativeLayout>

        </android.widget.Toolbar>

        <FrameLayout
            android:id="@+id/frame_pickupdrop_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbar"
            android:layout_marginTop="15dp"
            android:animateLayoutChanges="true"
            android:background="@android:color/transparent"
            android:elevation="10dp"
            tools:ignore="UnusedAttribute">


            <RelativeLayout
                android:id="@+id/rl_pickup_layout_parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_pickup_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="14dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="2dp"
                    app:cardElevation="3dp">

                    <RelativeLayout
                        android:id="@+id/rl_pickup_layout"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="2dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="2dp">

                        <ImageView
                            android:id="@+id/img_pickup_indicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignTop="@+id/txt_pickup_hint"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="8dp"
                            android:src="@drawable/ic_pickup_indicator" />


                        <com.instaguard.user.CustomViews.CustomTextView
                            android:id="@+id/txt_pickup_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="2dp"
                            android:layout_toEndOf="@+id/img_pickup_indicator"
                            android:drawablePadding="5dp"
                            android:text="@string/mainactivity_your_location_label"
                            android:textColor="@color/colorAccent"
                            android:textSize="12sp" />

                        <com.instaguard.user.CustomViews.CustomTextView
                            android:id="@+id/txt_pickup_location"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="26dp"
                            android:layout_marginEnd="0dp"
                            android:layout_marginBottom="2dp"
                            android:ellipsize="end"
                            android:gravity="top|bottom|center_vertical|fill_vertical|center|fill"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:text="@string/map_enter_pickup_location"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </RelativeLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_drop_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/cv_pickup_layout"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="14dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="2dp"
                    app:cardElevation="3dp">

                    <RelativeLayout
                        android:id="@+id/rl_drop_layout"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="2dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="2dp">

                        <ImageView
                            android:id="@+id/img_drop_indicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignTop="@+id/txt_drop_hint"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="8dp"
                            android:contentDescription="@string/todo"
                            android:src="@drawable/ic_pickup_indicator"
                            app:tint="@color/field_text_color_error" />


                        <com.instaguard.user.CustomViews.CustomTextView
                            android:id="@+id/txt_drop_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="2dp"
                            android:layout_toEndOf="@+id/img_drop_indicator"
                            android:drawablePadding="5dp"
                            android:text="@string/map_drop_location"
                            android:textColor="@color/colorAccent"
                            android:textSize="12sp" />

                        <com.instaguard.user.CustomViews.CustomTextView
                            android:id="@+id/txt_drop_location"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="26dp"
                            android:layout_marginEnd="0dp"
                            android:layout_marginBottom="2dp"
                            android:ellipsize="end"
                            android:gravity="top|bottom|center_vertical|fill_vertical|center|fill"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:text="@string/map_enter_drop_location"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </RelativeLayout>

                </androidx.cardview.widget.CardView>

                <!--  <ImageView
                      android:id="@+id/img_pickup_arrow"
                      android:layout_width="35dp"
                      android:layout_height="20dp"
                      android:layout_below="@+id/cv_pickup_layout"
                      android:layout_centerHorizontal="true"
                      android:layout_gravity="center_horizontal"
                      android:layout_marginTop="-4dp"
                      android:elevation="8dp"
                      android:src="@drawable/img_arrow" />-->


            </RelativeLayout>

        </FrameLayout>

        <RelativeLayout
            android:id="@+id/rl_centermarker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:elevation="4dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_centermarker"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="15dp"
                android:paddingBottom="15dp"
                android:src="@drawable/img_map_pickup_marker" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_currentLoction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/frame_pickupdrop_layout"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_margin="10dp"
            android:background="@drawable/ic_shape_circle"
            android:clickable="true"
            android:elevation="10dp"
            tools:ignore="OnClick,UnusedAttribute">

            <ImageView
                android:id="@+id/img_currentLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_my_location" />

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_google_watermark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/rl_bottom_parent"
            android:visibility="invisible">

            <ImageView
                android:layout_width="75dp"
                android:layout_height="30dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_maps_watermark_color" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_bottom_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:visibility="visible">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_catgorylayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:padding="3dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="5dp"
                app:cardUseCompatPadding="false"
                app:layout_collapseMode="parallax">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.instaguard.user.Helpers.ExpansionPanelLayout.ExpansionHeader
                        android:id="@+id/expHeader_top_main"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        app:expansion_headerIndicator="@id/headerIndicator_main"
                        app:expansion_layout="@id/expansionLayout_main"
                        app:expansion_toggleOnClick="true">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:id="@+id/ll_promo_"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5.0dip"
                                android:layout_toStartOf="@+id/headerIndicator_main"
                                android:background="@color/white"
                                android:orientation="vertical"
                                android:paddingStart="10.0dip"
                                android:paddingTop="10.0dip"
                                android:paddingBottom="10.0dip"
                                android:paddingEnd="4.0dip">

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_rect_border"
                                    android:backgroundTint="@color/gray_light"
                                    android:visibility="visible">

                                    <com.rengwuxian.materialedittext.MaterialEditText
                                        android:id="@+id/ed_countt"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_marginTop="5dp"
                                        android:layout_marginEnd="5dp"
                                        android:layout_marginBottom="5dp"
                                        android:hint="@string/number_of_guard_size"
                                        android:imeOptions="actionDone"
                                        android:inputType="number"
                                        android:focusable="false"
                                        android:clickable="false"
                                        android:focusableInTouchMode="false"
                                        android:textSize="14sp"
                                        app:met_floatingLabel="highlight"
                                        app:met_floatingLabelAlwaysShown="true"
                                        app:met_floatingLabelText="@string/number_of_bodyguards"
                                        app:met_floatingLabelTextColor="@color/black"
                                        app:met_hideUnderline="true" />

                                </RelativeLayout>

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:background="@drawable/bg_rect_border"
                                    android:backgroundTint="@color/gray_light"
                                    android:visibility="gone">

                                    <com.rengwuxian.materialedittext.MaterialEditText
                                        android:id="@+id/ed_hrs"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="5dp"
                                        android:layout_marginTop="5dp"
                                        android:layout_marginEnd="5dp"
                                        android:layout_marginBottom="5dp"
                                        android:hint="@string/enter_no_of_days"
                                        android:imeOptions="actionDone"
                                        android:inputType="number"
                                        android:text="0"
                                        android:textSize="14sp"
                                        app:met_floatingLabel="highlight"
                                        app:met_floatingLabelAlwaysShown="true"
                                        app:met_floatingLabelText="@string/no_of_days"
                                        app:met_floatingLabelTextColor="@color/black"
                                        app:met_hideUnderline="true" />

                                </RelativeLayout>

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:background="@drawable/bg_rect_border"
                                    android:backgroundTint="@color/gray_light">

                                    <com.instaguard.user.CustomViews.CustomEditText
                                        android:id="@+id/ed_tell_us_emergency"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_marginTop="5dp"
                                        android:layout_marginEnd="5dp"
                                        android:layout_marginBottom="5dp"
                                        android:hint="@string/enter_tell_us_emeregency"
                                        android:focusable="false"
                                        android:clickable="false"
                                        android:focusableInTouchMode="false"
                                        android:imeOptions="actionDone"
                                        android:inputType="number"
                                        android:textSize="14sp"
                                        app:met_floatingLabel="highlight"
                                        app:met_floatingLabelAlwaysShown="true"
                                        app:met_floatingLabelText="@string/please_tell_us_emergency"
                                        app:met_floatingLabelTextColor="@color/black"
                                        app:met_hideUnderline="true" />

                                </RelativeLayout>

                            </LinearLayout>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/uniqueBtn"
                                android:layout_width="wrap_content"
                                android:paddingStart="@dimen/marginBottom_10"
                                android:paddingEnd="@dimen/marginBottom_10"
                                android:layout_height="40dp"
                                android:layout_marginTop="4dp"
                                android:layout_below="@+id/ll_promo_"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="20sp"
                                android:background="@drawable/bg_toolbar_gradient"
                                android:textColor="@color/white"
                                android:text="@string/search_guard_with_unique_id"
                                android:textAllCaps="false"/>

                            <ImageView
                                android:id="@+id/headerIndicator_main"
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                android:layout_gravity="center"
                                android:layout_marginStart="0dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/ic_circle_elevation_white"
                                android:contentDescription="@string/todo"
                                android:padding="8dp"
                                android:src="@drawable/ic_expansion_header_indicator_grey_24dp"
                                android:visibility="visible" />

                        </RelativeLayout>

                    </com.instaguard.user.Helpers.ExpansionPanelLayout.ExpansionHeader>

                    <com.instaguard.user.Helpers.ExpansionPanelLayout.ExpansionLayout
                        android:id="@+id/expansionLayout_main"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/expHeader_top_main"
                        app:expansion_expanded="false">

                        <RelativeLayout
                            android:id="@+id/rl_categorylayout"
                            android:layout_width="match_parent"
                            android:layout_height="106dp"
                            android:layout_margin="1dp"
                            android:background="@color/white"
                            android:padding="0dp"
                            android:visibility="visible">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toStartOf="@+id/tv_right_arrow"
                                android:layout_toEndOf="@+id/tv_left_arrow">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rv_sub_category"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:layout_marginStart="0dp"
                                    android:layout_marginEnd="0dp"
                                    android:background="@color/white"
                                    android:orientation="horizontal"
                                    android:scrollbarSize="2dp"
                                    android:scrollbars="horizontal"
                                    android:visibility="visible"
                                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                    tools:itemCount="2"
                                    tools:listitem="@layout/adapter_mapsubcategory_main" />

                            </RelativeLayout>

                            <com.instaguard.user.CustomViews.CustomTextView
                                android:id="@+id/txt_no_records"
                                android:layout_width="match_parent"
                                android:layout_height="105dp"
                                android:layout_centerInParent="true"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/no_record_found"
                                android:textColor="@color/colorPrimaryDark"
                                android:visibility="gone" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/tv_left_arrow"
                                android:layout_width="wrap_content"
                                android:layout_height="50dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:padding="2dp"
                                android:src="@drawable/ic_chevron_left_black"
                                android:tint="#505050"
                                android:visibility="invisible" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/tv_right_arrow"
                                android:layout_width="wrap_content"
                                android:layout_height="50dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:padding="2dp"
                                android:src="@drawable/ic_chevron_right_black"
                                android:tint="#505050"
                                android:visibility="invisible" />

                            <com.instaguard.user.CustomViews.CustomTextView
                                android:id="@+id/txt_refresh"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_centerHorizontal="true"
                                android:layout_marginStart="5dp"
                                android:layout_marginTop="5dp"
                                android:layout_marginEnd="5dp"
                                android:layout_marginBottom="5dp"
                                android:drawableStart="@drawable/ic_refresh_black_small"
                                android:drawablePadding="5dp"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/refresh"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                android:visibility="gone" />

                        </RelativeLayout>

                    </com.instaguard.user.Helpers.ExpansionPanelLayout.ExpansionLayout>

                    <RelativeLayout
                        android:id="@+id/rl_pb_main_category"
                        android:layout_width="wrap_content"
                        android:layout_height="100dp"
                        android:layout_below="@+id/expHeader_top_main"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="center"
                        android:gravity="center">

                        <ProgressBar
                            android:id="@+id/pb_main_category"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="0dp"
                            android:indeterminateTint="@color/black"
                            android:progressTint="@color/black"
                            android:secondaryProgressTint="@color/black"
                            android:visibility="visible" />

                        <com.instaguard.user.CustomViews.CustomTextView
                            android:id="@+id/txt_loading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/pb_main_category"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:layout_margin="5dp"
                            android:gravity="center"
                            android:hint="@string/loading"
                            android:visibility="visible" />

                    </RelativeLayout>

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/ll_btn_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/cv_catgorylayout"
                android:background="@drawable/bg_toolbar_gradient_bottom_top_curve"
                android:orientation="horizontal"
                android:visibility="gone"
                android:weightSum="2">

                <com.instaguard.user.CustomViews.CustomButton
                    android:id="@+id/btn_booknow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/ic_book_now"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/white"
                    android:gravity="center"
                    android:paddingStart="15dp"
                    android:paddingTop="6dp"
                    android:textAllCaps="false"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="@string/sos_emergency"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0.2dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/white" />

                <com.instaguard.user.CustomViews.CustomButton
                    android:id="@+id/btn_booklater"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:background="@android:color/transparent"
                    android:drawableEnd="@drawable/ic_book_later"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/white"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="6dp"
                    android:text="@string/book_a_security_guard"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/rl_next_parent_lyt"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ll_btn_ll"
                android:layout_alignParentEnd="true"
                android:visibility="gone">

                <com.instaguard.user.CustomViews.CustomButton
                    android:id="@+id/btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_rect_filled_colorprimary"
                    android:padding="5dp"
                    android:text="@string/next"
                    android:textColor="@color/white"
                    android:visibility="visible" />

                <com.instaguard.user.CustomViews.CustomButton
                    android:id="@+id/btn_done"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_rect_filled_colorprimary"
                    android:padding="5dp"
                    android:text="@string/next"
                    android:textColor="@color/white"
                    android:visibility="visible" />

            </RelativeLayout>

            <com.instaguard.user.CustomViews.CustomButton
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_below="@+id/rl_next_parent_lyt"
                android:visibility="gone" />

        </RelativeLayout>

    </RelativeLayout>

    <include
        android:id="@+id/lyt_schedule_date_time_selection"
