<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="5dp"
    android:background="#8AEDEDED">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
         android:layout_margin="10.0dip"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_rect_border_white_elevation"
        android:padding="2dp">

        <LinearLayout
            android:id="@+id/ll_addcharge_title_area"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip"
            android:orientation="vertical"
            android:padding="10.0dip">


            <LinearLayout
                android:id="@+id/rateDriverArea"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.instaguard.user.CustomViews.CustomTextView
                    android:id="@+id/ufxratingDriverHTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="5.0dip"
                    android:text="@string/dialog_trip_summary_how_s_your_ride_rate_user"
                    android:textColor="#ff727272"
                    android:textSize="16sp" />

                <com.instaguard.user.Helpers.RatingBar.SimpleRatingBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="2.0dip"
                    app:srb_borderColor="@color/colorPrimary"
                    app:srb_fillColor="@color/colorPrimaryDark"
                    app:srb_numberOfStars="5"
                    app:srb_starSize="45sp"
                    android:id="@+id/rb_updatedriverrating"
                    app:srb_stepSize="0.5"
                    android:layout_marginTop="10dp"/>

                <com.instaguard.user.CustomViews.CustomEditText
                    android:id="@+id/edt_comment_updatedriverrating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:digits="._abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890@ "
                    android:hint="@string/trip_summary_enter_your_comment"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:clickable="false"
                    app:met_floatingLabel="highlight"
                    app:met_floatingLabelAlwaysShown="false"
                    app:met_floatingLabelAnimating="true"
                    app:met_floatingLabelTextColor="@color/black"
                    app:met_textColorHint="@color/black"
                    tools:ignore="RtlSymmetry" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="2">
                <com.instaguard.user.CustomViews.CustomButton
                    android:id="@+id/btn_cancel_updatedriverrating"
                    android:layout_width="wrap_content"
                    android:text="@string/trip_summary_cancel"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    android:layout_marginBottom="10dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_rect_filled_colorprimary"
                    android:layout_height="45sp" />
                <com.instaguard.user.CustomViews.CustomButton
                    android:id="@+id/btn_rating_updatedriverrating"
                    android:layout_width="wrap_content"
                    android:text="@string/trip_summary_rate"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    android:layout_margin="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_rect_filled_colorprimary"
                    android:layout_height="45sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        


    </LinearLayout>

</RelativeLayout>