<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@android:color/darker_gray"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/reqRelView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <LinearLayout
            android:id="@+id/retryBtnArea"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.instaguard.user.CustomViews.CustomTextView
                android:id="@+id/noDriverNotifyTxt"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:gravity="center|left"
                android:maxLines="5"
                android:minHeight="50.0dip"
                android:padding="5.0dip"
                android:text="@string/requesting_nodriver"
                android:textColor="#ffffffff"
                android:textSize="16dp" />

            <com.instaguard.user.CustomViews.CustomButton
                android:id="@+id/btn_type2"
                android:layout_width="150.0dip"
                android:layout_height="45dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10.0dip"
                android:layout_marginEnd="10.0dip" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_margin="15dp"
            android:background="@color/white">

            <ImageView
                android:id="@+id/img_accept"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:src="@drawable/logo" />

            <RelativeLayout
                android:id="@+id/success"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/img_accept"
                android:layout_centerInParent="true"
                android:layout_margin="0dp"
                android:layout_marginTop="20dp"
                android:background="@color/white"
                android:visibility="visible">

                <com.instaguard.user.CustomViews.CustomTextView
                    android:id="@+id/txt_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:text="@string/map_accept_provider_booking_accepted"
                    android:textColor="@color/black"
                    android:textSize="25dp"
                    android:visibility="visible" />

                <com.instaguard.user.CustomViews.CustomTextView
                    android:id="@+id/txt_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txt_header"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginBottom="15dp"
                    android:gravity="center_horizontal"
                    android:text="@string/map_accept_provider_driver_has_accepted_your_request_and_arriving_at_your_location_you_can_check_the_status_by_tapping_below_button"
                    android:textColor="@color/black"
                    android:textSize="18dp"
                    android:visibility="visible" />


                <com.instaguard.user.CustomViews.CustomTextView
                    android:id="@+id/txt_viewongoingjobs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="0dp"
                    android:layout_below="@+id/txt_description"
                    android:background="@drawable/bg_rect_filled_colorprimary"
                    android:gravity="end"
                    android:padding="12dp"
                    android:text="@string/map_accept_provider_view_on_going_jobs"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/white"
                    android:textSize="16dp"
                    android:visibility="visible" />

                <com.instaguard.user.CustomViews.CustomTextView
                    android:id="@+id/txt_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_toStartOf="@+id/txt_viewongoingjobs"
                    android:gravity="end"
                    android:padding="10dp"
                    android:text="@string/ok"
                    android:textColor="@color/colorPrimary"
                    android:textSize="16dp"
                    android:visibility="gone" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/success1"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_margin="0dp"
                android:layout_below="@+id/success"
                android:layout_marginTop="20dp"
                android:background="@color/white"
                android:visibility="visible">

                <com.instaguard.user.CustomViews.CustomTextView
                    android:id="@+id/txt_header1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:text="@string/driver_decline_request_header"
                    android:textColor="@color/black"
                    android:textSize="25dp"
                    android:visibility="visible" />

                <com.instaguard.user.CustomViews.CustomTextView
                    android:id="@+id/txt_description1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txt_header1"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginBottom="15dp"
                    android:gravity="center_horizontal"
                    android:text="@string/driver_decline_request"
                    android:textColor="@color/black"
                    android:textSize="18dp"
                    android:visibility="visible" />

                <com.instaguard.user.CustomViews.CustomTextView
                    android:id="@+id/txt_viewongoingjobs1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="end"
                    android:padding="10dp"
                    android:text="@string/map_accept_provider_view_on_going_jobs"
                    android:textColor="@color/colorPrimary"
                    android:textSize="16dp"
                    android:visibility="gone" />

                <com.instaguard.user.CustomViews.CustomTextView
                    android:id="@+id/txt_cancel1"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_below="@+id/txt_description1"
                    android:layout_toStartOf="@+id/txt_viewongoingjobs1"
                    android:background="@drawable/bg_rect_filled_colorprimary"
                    android:gravity="center"
                    android:padding="15dp"
                    android:text="@string/ok"
                    android:textColor="@color/white"
                    android:textSize="16dp"
                    android:visibility="visible" />

            </RelativeLayout>

        </RelativeLayout>

    </RelativeLayout>

</LinearLayout>