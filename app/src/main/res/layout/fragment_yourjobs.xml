<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <android.widget.Toolbar
        android:id="@+id/toolbar_ride_history"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_toolbar_gradient">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/imgbtn_back"
                style="@style/AppThemeToolBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:contentDescription="@string/todo"
                android:padding="10dp"
                android:src="@drawable/ic_back_whitearrow" />

            <com.instaguard.user.CustomViews.CustomTextView
                android:id="@+id/txt_signin"
                style="@style/AppThemeToolBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/imgbtn_back"
                android:layout_alignBottom="@+id/imgbtn_back"
                android:layout_centerInParent="true"
                android:layout_marginStart="0dp"
                android:layout_toStartOf="@+id/iv_menu_profile"
                android:layout_toEndOf="@+id/imgbtn_back"
                android:foregroundGravity="center"
                android:gravity="center|start"
                android:text="@string/your_jobs_header"
                tools:ignore="MissingPrefix" />

            <ImageView
                android:id="@+id/iv_menu_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="top|right"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/ic_menu_vertical"
                android:contentDescription="@string/todo"
                android:padding="5dp"
                android:visibility="invisible"
                tools:ignore="RtlHardcoded" />

        </RelativeLayout>

    </android.widget.Toolbar>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar_ride_history"
        android:background="@color/white">

        <include
            android:id="@+id/rl__g"
            layout="@layout/layout_google_ads_view" />

        <RelativeLayout
            android:id="@+id/rltop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl__g"
            android:layout_marginTop="0dp">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/layout_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimary"
                android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
                android:weightSum="2"
                app:elevation="0dp">


                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:elevation="0dp"
                    android:paddingTop="3dp"
                    android:visibility="visible"
                    app:tabGravity="fill"
                    app:tabIndicatorColor="@color/colorPrimaryDark"
                    app:tabIndicatorHeight="1dp"
                    app:tabMode="fixed"
                    app:tabSelectedTextColor="@color/colorPrimaryDark"
                    app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
                    app:tabTextColor="#ccc" />


            </com.google.android.material.appbar.AppBarLayout>


        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/lyt_fb_view"
            android:layout_below="@+id/rltop"
            android:background="@drawable/bg_tab_whiteshape">

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/viewpager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        </LinearLayout>

        <include
            android:id="@+id/lyt_fb_view"
            layout="@layout/layout_facebook_ads_view" />

    </RelativeLayout>

</RelativeLayout>


