<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame_mywallet"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <RelativeLayout
        android:id="@+id/rl_parent_lyt_wallet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:ignore="UselessParent">

        <android.widget.Toolbar
            android:id="@+id/toolbar_wallet"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_toolbar_gradient">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/imgbtn_back"
                    style="@style/AppThemeToolBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:contentDescription="@string/todo"
                    android:padding="10dp"
                    android:src="@drawable/ic_back_whitearrow" />

                <com.instaguard.user.CustomViews.CustomTextView
                    android:id="@+id/textView"
                    style="@style/AppThemeToolBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/imgbtn_back"
                    android:layout_alignBottom="@+id/imgbtn_back"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="0dp"
                    android:layout_toStartOf="@+id/iv_menu_profile"
                    android:layout_toEndOf="@+id/imgbtn_back"
                    android:foregroundGravity="center"
                    android:gravity="center|start"
                    android:text="@string/my_wallet_title"
                    tools:ignore="MissingPrefix" />

                <ImageView
                    android:id="@+id/iv_menu_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_gravity="top|right"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/ic_menu_vertical"
                    android:contentDescription="@string/todo"
                    android:padding="5dp"
                    android:visibility="invisible"
                    tools:ignore="RtlHardcoded" />

            </RelativeLayout>


        </android.widget.Toolbar>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/toolbar_wallet"
            android:background="@color/bg_gray_common">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/ll_wallet_header"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:ignore="UselessParent">

                    <LinearLayout
                        android:id="@+id/ll_header_area"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.cardview.widget.CardView
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_toolbar_gradient_bottom_top"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="10.0dip"
                                    android:layout_marginTop="15.0dip"
                                    android:layout_marginEnd="10.0dip"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical">

                                    <com.instaguard.user.CustomViews.CustomTextView
                                        android:id="@+id/txt_yourbalance"
                                        style="@style/AppThemeToolBarCenter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        android:maxLines="1"
                                        android:text="@string/my_wallet_your_balance_text"
                                        android:textSize="13.0sp" />

                                    <com.instaguard.user.CustomViews.CustomTextView
                                        android:id="@+id/txt_walletamount"
                                        style="@style/AppThemeToolBarCenter"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="15.0dip"
                                        android:layout_marginBottom="10.0dip"
                                        android:gravity="center"
                                        android:maxLines="1"
                                        android:singleLine="true"
                                        android:text="@string/my_wallet_500"
                                        android:textSize="53.0sp" />

                                </LinearLayout>

                                <com.instaguard.user.CustomViews.CustomButton
                                    android:id="@+id/btn_viewtransactions"
                                    android:layout_width="fill_parent"
                                    android:layout_height="45sp"
                                    android:layout_gravity="bottom"
                                    android:layout_marginStart="25.0dip"
                                    android:layout_marginTop="10.0dip"
                                    android:layout_marginEnd="25.0dip"
                                    android:layout_marginBottom="10.0dip"
                                    android:background="@drawable/bg_rect_filled_colorprimary"
                                    android:text="@string/my_wallet_view_transactions_btn_text"
                                    android:textAllCaps="true"
                                    android:textColor="@color/white" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:id="@+id/ll_addmoney_header"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:background="#fff2f2f4"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <androidx.cardview.widget.CardView
                                android:layout_width="fill_parent"
                                android:layout_height="fill_parent">

                                <LinearLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10.0dip"
                                        android:layout_marginTop="15.0dip"
                                        android:layout_marginEnd="10.0dip"
                                        android:layout_marginBottom="5.0dip"
                                        android:gravity="center_vertical"
                                        android:orientation="vertical">

                                        <com.instaguard.user.CustomViews.CustomTextView
                                            android:id="@+id/txt_addmoney"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="15.0dip"
                                            android:gravity="start|center"
                                            android:maxLines="1"
                                            android:text="@string/my_wallet_add_money_text"
                                            android:textAlignment="viewStart"
                                            android:textColor="@color/colorPrimary"
                                            android:textSize="16sp" />

                                        <com.instaguard.user.CustomViews.CustomTextView
                                            android:id="@+id/txt_addmoney_tag"
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="15.0dip"
                                            android:layout_marginTop="5.0dip"
                                            android:layout_marginBottom="5.0dip"
                                            android:gravity="start|center"
                                            android:text="@string/my_wallet_it_s_safe_and_secure_text"
                                            android:textAlignment="viewStart"
                                            android:textColor="#ff000000"
                                            android:textSize="16sp" />

                                        <androidx.cardview.widget.CardView
                                            android:id="@+id/cv_recharge_amt_lyt"
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8.0dip"
                                            android:layout_marginTop="10.0dip"
                                            android:layout_marginEnd="8.0dip"
                                            android:paddingStart="5.0dip"
                                            android:paddingEnd="5.0dip"
                                            app:cardBackgroundColor="#ffffffff">

                                            <LinearLayout
                                                android:layout_width="fill_parent"
                                                android:layout_height="wrap_content"
                                                android:paddingTop="15.0dip"
                                                android:paddingBottom="15.0dip">

                                                <com.instaguard.user.CustomViews.CustomEditText
                                                    android:id="@+id/edt_recharge_amt"
                                                    android:layout_width="fill_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginStart="5.0dip"
                                                    android:layout_marginEnd="5.0dip"
                                                    android:hint="@string/my_wallet_recharge_amount_hint"
                                                    android:imeOptions="actionDone"
                                                    android:inputType="number"
                                                    android:maxLength="6"
                                                    android:singleLine="true"
                                                    android:textAlignment="viewStart"
                                                    app:met_floatingLabel="highlight"
                                                    app:met_floatingLabelAlwaysShown="false"
                                                    app:met_floatingLabelAnimating="true"
                                                    app:met_textColorHint="@color/hintgray" />
                                            </LinearLayout>
                                        </androidx.cardview.widget.CardView>

                                        <LinearLayout
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="15.0dip">

                                            <com.instaguard.user.CustomViews.CustomTextView
                                                android:id="@+id/txt_addmoney_one"
                                                android:layout_width="0.0dip"
                                                android:layout_height="45dp"
                                                android:layout_gravity="center_horizontal"
                                                android:layout_margin="8.0dip"
                                                android:layout_weight="1.0"
                                                android:background="@drawable/bg_wallet_border"
                                                android:gravity="center"
                                                android:paddingStart="25.0dip"
                                                android:paddingTop="10.0dip"
                                                android:paddingEnd="25.0dip"
                                                android:paddingBottom="10.0dip"
                                                android:text="300"
                                                android:textColor="#ffffffff"
                                                android:textSize="21.0sp" />

                                            <com.instaguard.user.CustomViews.CustomTextView
                                                android:id="@+id/txt_addmoney_two"
                                                android:layout_width="0.0dip"
                                                android:layout_height="45dp"
                                                android:layout_gravity="center_horizontal"
                                                android:layout_margin="8.0dip"
                                                android:layout_weight="1.0"
                                                android:background="@drawable/bg_wallet_border"
                                                android:gravity="center"
                                                android:paddingStart="25.0dip"
                                                android:paddingTop="10.0dip"
                                                android:paddingEnd="25.0dip"
                                                android:paddingBottom="10.0dip"
                                                android:text="500"
                                                android:textColor="#ffffffff"
                                                android:textSize="21.0sp" />

                                            <com.instaguard.user.CustomViews.CustomTextView
                                                android:id="@+id/txt_addmoney_three"
                                                android:layout_width="0.0dip"
                                                android:layout_height="45dp"
                                                android:layout_gravity="center_horizontal"
                                                android:layout_margin="8.0dip"
                                                android:layout_weight="1.0"
                                                android:background="@drawable/bg_wallet_border"
                                                android:gravity="center"
                                                android:paddingStart="25.0dip"
                                                android:paddingTop="10.0dip"
                                                android:paddingEnd="25.0dip"
                                                android:paddingBottom="10.0dip"
                                                android:text="1000"
                                                android:textColor="#ffffffff"
                                                android:textSize="21.0sp" />
                                        </LinearLayout>

                                        <LinearLayout
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center_vertical"
                                            android:gravity="center"
                                            android:orientation="vertical">

                                            <com.instaguard.user.CustomViews.CustomTextView
                                                android:id="@+id/txt_policy"
                                                android:layout_width="fill_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="5.0dip"
                                                android:layout_marginBottom="5.0dip"
                                                android:gravity="center"
                                                android:text="@string/my_wallet_by_conducting_you_choose_to_accept_linq_auto_club_text"
                                                android:textColor="@android:color/holo_red_light"
                                                android:textSize="16sp" />

                                            <com.instaguard.user.CustomViews.CustomTextView
                                                android:id="@+id/txt_terms"
                                                android:layout_width="fill_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="5.0dip"
                                                android:layout_marginBottom="5.0dip"
                                                android:gravity="center"
                                                android:text="@string/my_wallet_terms_amp_privacy_policy_text"
                                                android:textColor="@color/colorPrimary"
                                                android:textSize="16sp"
                                                android:visibility="gone" />
                                        </LinearLayout>

                                        <com.instaguard.user.CustomViews.CustomButton
                                            android:id="@+id/btn_addmoney"
                                            android:layout_width="fill_parent"
                                            android:layout_height="45sp"
                                            android:layout_gravity="bottom"
                                            android:layout_marginStart="8.0dip"
                                            android:layout_marginTop="10.0dip"
                                            android:layout_marginEnd="8.0dip"
                                            android:background="@drawable/bg_rect_filled_colorprimary"
                                            android:text="@string/my_wallet_add_money_btn_text"
                                            android:textAllCaps="true"
                                            android:textColor="@color/white" />


                                    </LinearLayout>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>

        </ScrollView>

    </RelativeLayout>

</FrameLayout>