                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:orientation="vertical"
                android:paddingBottom="5dp">

                <com.instaguard.user.Helpers.Creditcard.fields.CreditCardModule
                    android:id="@+id/credit_card_module"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="20dp"
                    android:visibility="gone" />

                <com.stripe.android.view.CardInputWidget
                    android:id="@+id/credit_card_module_stripe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:padding="15dp" />

            </LinearLayout>

            <com.instaguard.user.CustomViews.CustomButton
                android:id="@+id/pay_button"
                android:layout_width="match_parent"
                android:layout_height="45sp"
                android:layout_below="@+id/ll_stripe_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="10dp"
                android:background="@drawable/bg_rect_filled_colorprimary"
                android:gravity="center"
                android:text="Pay"
                android:textAllCaps="true"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </RelativeLayout>

        <com.instaguard.user.CustomViews.CustomTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="20sp"
            android:gravity="start"
            android:hint="for Demo use:- \n Creditcard: 4111 1111 1111 1111 \n mm/yy : 06/22 \n cvv :123"
            android:textColorHint="@android:color/darker_gray"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
